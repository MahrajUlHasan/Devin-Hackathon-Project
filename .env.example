# Copy to .env and fill in. NEVER commit .env.

# Alpaca paper trading. Get keys at https://app.alpaca.markets (Paper account).
ALPACA_API_KEY=

ALPACA_API_SECRET=
ALPACA_PAPER=true

# --- LLM provider -------------------------------------------------------------------
# Which vendor runs the eight agents: anthropic | gemini | auto
# "auto" picks Anthropic if its key is set, otherwise Gemini. Overridden by --provider.
LLM_PROVIDER=auto

# Anthropic. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini. https://aistudio.google.com/apikey  (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=

# Optional per-tier model pins. Leave unset to use the defaults in config.py.
# CLAUDE_MODEL_FAST=claude-haiku-4-5
# CLAUDE_MODEL_MID=claude-sonnet-5
# CLAUDE_MODEL_DEEP=claude-opus-5
# GEMINI_MODEL_FAST=gemini-flash-lite-latest
# GEMINI_MODEL_MID=gemini-flash-latest
# GEMINI_MODEL_DEEP=gemini-pro-latest

# Runtime
BUDAPILOT_DB=budapilot.db
BUDAPILOT_HOST=127.0.0.1
BUDAPILOT_PORT=8000
