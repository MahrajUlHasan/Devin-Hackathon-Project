# Copy to .env and fill in. NEVER commit .env.

# Alpaca paper trading. Get keys at https://app.alpaca.markets (Paper account).
ALPACA_API_KEY=

ALPACA_API_SECRET=
ALPACA_PAPER=true

# --- LLM provider -------------------------------------------------------------------
# Which vendor runs the eight agents: anthropic | gemini | auto
# "auto" picks Anthropic if its key is set, otherwise Gemini. Overridden by --provider.
# When both keys are set, a failed call on the primary is retried once on the other
# vendor before the agent degrades to its stub (disable with --no-fallback).
LLM_PROVIDER=auto

# Anthropic. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini. https://aistudio.google.com/apikey  (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=

# Optional per-tier model pins. Leave unset to use the defaults in config.py.
# CLAUDE_MODEL_FAST=claude-haiku-4-5
# CLAUDE_MODEL_MID=claude-sonnet-5
# CLAUDE_MODEL_DEEP=claude-opus-5
# GEMINI_MODEL_FAST=gemini-3.6-flash
# GEMINI_MODEL_MID=gemini-3.7-flash
# GEMINI_MODEL_DEEP=gemini-3.8-flash

# Runtime
BUDAPILOT_DB=budapilot.db
BUDAPILOT_HOST=127.0.0.1
BUDAPILOT_PORT=8000

# --- Hosting (Railway etc.) ---------------------------------------------------------
# The platform injects PORT; it wins over BUDAPILOT_PORT and switches the bind to 0.0.0.0.
# Keep the dashboard up after the loop's time budget is spent (else the process exits).
# BUDAPILOT_SERVE_AFTER_DONE=true
# Require this header (X-Dashboard-Token) on the buttons: pause/start, watchlist, deep.
# Reads stay public. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# BUDAPILOT_DASHBOARD_TOKEN=
